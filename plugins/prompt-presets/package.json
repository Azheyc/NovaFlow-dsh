{
  "name": "novaflow-dsh-prompt-presets",
  "version": "2.0.0",
  "description": "NovaFlow 企业工作提示词与个人自定义预设，所有模式共用",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": { ".": "./index.js", "./client": "./client.js", "./package.json": "./package.json" },
  "files": ["index.js", "catalog.js", "client.js", "cordis.patch.yml", "README.md"],
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-primitives"] }
  }
}
